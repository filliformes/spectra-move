{
  "title": "Spectra",
  "children": [
    {
      "title": "About",
      "lines": [
        "Multiband spectral",
        "resonator. Audio FX.",
        "",
        "Pitch-tracking SVF",
        "resonator bank with",
        "scale quantizer, 12",
        "scales x 12 roots,",
        "chord drift.",
        "",
        "Analyses input audio",
        "(pitch, onset, noise",
        "ratio) and excites",
        "scale-quantized",
        "bandpass filters."
      ]
    },
    {
